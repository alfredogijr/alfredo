# Google Ads API Credentials
# Copie este arquivo para .env e preencha com suas credenciais reais

# Developer Token (obtido no Google Ads API Center)
GOOGLE_ADS_DEVELOPER_TOKEN=seu_developer_token_aqui

# OAuth2 Credentials (do Google Cloud Console)
GOOGLE_ADS_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=seu_client_secret_aqui
GOOGLE_ADS_REFRESH_TOKEN=seu_refresh_token_aqui

# MCC Login Customer ID (ID da sua conta MCC sem hífens)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# Opcional: conta cliente padrão para operações
# GOOGLE_ADS_DEFAULT_CUSTOMER_ID=9876543210
