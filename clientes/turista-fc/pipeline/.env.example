# Copie este arquivo como .env e preencha com suas credenciais para testes locais.
# NUNCA commite o .env — ele já está no .gitignore.

# 1. Anthropic — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# 2. Metricool — app.metricool.com → Settings → Integrations → API
METRICOOL_TOKEN=...

# 3. Google Drive — cole o conteúdo INTEIRO do arquivo JSON da service account
#    (abra o .json, seleciona tudo, cola aqui numa linha só entre aspas simples)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# 4. Google Drive — ID da pasta (últimos caracteres da URL da pasta no Drive)
GOOGLE_DRIVE_FOLDER_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ
